From 7429a3d028dc11646bfe813225eec772c27559e6 Mon Sep 17 00:00:00 2001
From: obsesivegamer <jeremylichtman112@gmail.com>
Date: Sat, 5 Sep 2026 14:20:08 -0400
Subject: [PATCH] ci: add GitHub Actions workflow for daily Mastodon data
 updates

---
 .github/workflows/update-data.yml | 37 +++++++++++++++++++++++++++++++
 1 file changed, 37 insertions(+)
 create mode 100644 .github/workflows/update-data.yml

diff --git a/.github/workflows/update-data.yml b/.github/workflows/update-data.yml
new file mode 100644
index 0000000..5186c70
--- /dev/null
+++ b/.github/workflows/update-data.yml
@@ -0,0 +1,37 @@
+name: Update Mastodon Data
+
+on:
+  schedule:
+    # Run daily at 06:00 UTC (after the previous day's data has fully settled)
+    - cron: '0 6 * * *'
+  workflow_dispatch: # Allow manual trigger from the Actions tab
+
+permissions:
+  contents: write
+
+jobs:
+  update-data:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+
+      - name: Setup Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+
+      - name: Fetch latest Mastodon statistics
+        run: node updateData.js
+
+      - name: Commit and push if data changed
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "github-actions[bot]@users.noreply.github.com"
+          git add historicalData.js
+          if git diff --cached --quiet; then
+            echo "No new data to commit."
+          else
+            git commit -m "chore: daily data update (automated)"
+            git push
+          fi
-- 
2.50.1 (Apple Git-155)

